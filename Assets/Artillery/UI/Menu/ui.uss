.menu-button {
    -unity-font: url('project://database/Assets/TextMesh%20Pro/Fonts/Kaph-Regular.ttf?fileID=12800000&guid=e8678397bb27c2041bdcc09ba93b383e&type=3#Kaph-Regular');
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgba(7, 7, 7, 0);
    border-right-color: rgba(7, 7, 7, 0);
    border-top-color: rgba(7, 7, 7, 0);
    border-bottom-color: rgba(7, 7, 7, 0);
    width: 525px;
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
    transition-duration: 0.2s;
    height: 100px;
    font-size: 42px;
    background-color: rgb(230, 255, 248);
    -unity-font-definition: initial;
}

.menu-button:hover {
    translate: 0 -3px;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-cubic;
    scale: 1.1 1.1;
    background-color: rgb(150, 226, 144);
}

.menu-red-button:hover {
    translate: 0 -1px;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-cubic;
    scale: 1.15 1.15;
    background-color: rgb(229, 146, 120);
}
